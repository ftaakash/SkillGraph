generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  RECRUITER
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  role                UserRole  @default(STUDENT)
  college             String?
  branch              String?
  year                String?
  targetRole          String?
  readinessScore      Float?
  readinessScorePrev  Float?
  resumeUrl           String?
  sprintsCompleted    Int       @default(0)
  optimizerSessions   Int       @default(0)
  
  // Faculty fields
  collegeId         String?
  College           CollegeInstitution? @relation(fields: [collegeId], references: [id])

  // Recruiter fields
  companyId         String?
  Company           Company?    @relation(fields: [companyId], references: [id])
  isVerified        Boolean     @default(false)

  // Student specific v2
  cgpa              Float?
  isProfileVisible  Boolean     @default(false)

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  skills              SkillProfile[]
  gaps                SkillGap[]
  sprints             Sprint[]
  optimizerSessions_  OptimizerSession[]

  OpenClawConfig       OpenClawConfig?
  OpenClawApplications OpenClawApplication[]
  ResumeVersions       ResumeVersion[]
  Applications         JobApplication[]
  TalentViews          RecruiterTalentView[] @relation("TalentViews")
  Notifications        Notification[]
}

model SkillProfile {
  id          String   @id @default(cuid())
  userId      String
  skillName   String
  category    String   // technical | soft | tool | framework
  proficiency String   @default("beginner") // beginner | intermediate | advanced
  source      String   @default("resume")   // resume | manual
  extractedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model JobPosting {
  id             String    @id @default(cuid())
  company        String
  role           String
  location       String?
  salaryBand     String?
  requiredSkills Json      // string[]
  rawDescription String    @db.Text
  postedDate     DateTime?
  scrapedAt      DateTime  @default(now())
  source         String    @default("linkedin")
  demandWeek     Int       // ISO week number (1-53)
}

model SkillGap {
  id              String   @id @default(cuid())
  userId          String
  missingSkill    String
  urgency         String   // high | medium | low
  weeksToLearn    Int
  whyImportant    String   @db.Text
  demandScore     Float    @default(0)
  resourceLinks   Json?    // string[]
  closed          Boolean  @default(false)
  sprintGenerated Boolean  @default(false)
  identifiedAt    DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Sprint {
  id                   String    @id @default(cuid())
  userId               String
  weekStartDate        DateTime
  dayTasks             Json      // DayTask[7]
  completionPercentage Float     @default(0)
  skillsTargeted       Json      // string[3]
  status               String    @default("active") // active | completed | abandoned
  generatedAt          DateTime  @default(now())
  completedAt          DateTime?

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Benchmark {
  id             String   @id @default(cuid())
  role           String
  year           String
  readinessScore Float
  collegeTier    String   // Tier-1 | Tier-2 | Tier-3
  createdAt      DateTime @default(now())
  // NO userId - fully anonymous
}

model OptimizerSession {
  id             String   @id @default(cuid())
  userId         String
  targetRole     String
  atsScoreBefore Float
  atsScoreAfter  Float
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// -------------------------------------------------------------
// V2 EXPANSION MODELS
// -------------------------------------------------------------

model CollegeInstitution {
  id             String   @id @default(cuid())
  name           String
  city           String
  state          String
  tier           String
  naacGrade      String?
  tpContactEmail String
  facultyUsers   User[]
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  website            String?
  tier               String
  verificationStatus String   @default("pending")
  logoUrl            String?
  hrEmail            String
  recruiters         User[]
}

model FacultyJobPosting {
  id               String   @id @default(cuid())
  collegeId        String?
  companyId        String?
  title            String
  company          String
  description      String   @db.Text
  ctcMin           Float?
  ctcMax           Float?
  minCgpa          Float?
  eligibleBranches Json?    // string[]
  deadline         DateTime
  driveDate        DateTime?
  applicationCount Int      @default(0)
  createdAt        DateTime @default(now())
}

model JobApplication {
  id              String   @id @default(cuid())
  userId          String
  jobPostingId    String
  resumeVersionId String?
  coverLetter     String?  @db.Text
  status          String   @default("Applied") // Applied | Shortlisted | Rejected | Placed
  appliedAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ResumeVersion {
  id              String   @id @default(cuid())
  userId          String
  cloudinaryUrl   String?
  atsScore        Float?
  targetJd        String?  @db.Text
  generatedBy     String   @default("Manual") // AI | Manual
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OpenClawConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  targetRoles          Json     // string[]
  preferredCities      Json     // string[]
  minCtcLpa            Float
  dailyLimit           Int      @default(10)
  blacklistedCompanies Json     // string[]
  isActive             Boolean  @default(true)

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OpenClawListing {
  id              String   @id @default(cuid())
  platform        String
  company         String
  role            String
  location        String?
  ctcBand         String?
  jdText          String   @db.Text
  sourceUrl       String
  scrapedAt       DateTime @default(now())
}

model OpenClawApplication {
  id              String   @id @default(cuid())
  userId          String
  listingId       String
  matchScore      Float?
  resumeVersionId String?
  status          String   @default("Applied")
  screenshotUrl   String?
  tailoringNotes  String?  @db.Text
  appliedAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecruiterTalentView {
  id              String    @id @default(cuid())
  recruiterId     String
  studentId       String
  revealedAt      DateTime?
  shortlisted     Boolean   @default(false)
  viewedAt        DateTime  @default(now())
  notes           String?

  student         User      @relation("TalentViews", fields: [studentId], references: [id], onDelete: Cascade)
}

model IndiaMarketData {
  id              String   @id @default(cuid())
  skill           String?
  role            String?
  city            String?
  demandCount     Int?
  avgCtcLpa       Float?
  companyTier     String?
  weekOf          DateTime
}

model PlacementRecord {
  id              String   @id @default(cuid())
  collegeId       String
  studentId       String
  company         String
  role            String
  ctcLpa          Float?
  offerDate       DateTime?
  batch           String?
  isVerified      Boolean  @default(false)
}

model ResumeSection {
  id              String   @id @default(cuid())
  resumeVersionId String
  type            String   // Summary | Experience | Skills | Projects | Education
  content         Json
  atsContribution Float?
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // job_posted | status_changed | shortlisted | offer | system
  title     String
  body      String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}
