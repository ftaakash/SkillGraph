generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  STUDENT
  FACULTY
  RECRUITER
}

model User {
  id                  String    @id @default(cuid())
  name                String
  email               String    @unique
  passwordHash        String
  // Account security & consent (ADR-001 Phase 3)
  emailVerifiedAt     DateTime?
  sessionVersion      Int       @default(0) // bump to invalidate all existing sessions
  termsAcceptedAt     DateTime?
  termsVersion        String?
  role                UserRole  @default(STUDENT)
  college             String?
  branch              String?
  year                String?
  targetRole          String?
  readinessScore      Float?
  readinessScorePrev  Float?
  resumeUrl           String?
  sprintsCompleted    Int       @default(0)
  optimizerSessions   Int       @default(0)

  // Faculty fields
  collegeId         String?   // faculty: their workspace; student: the college they joined with a join code
  collegeJoinedAt   DateTime? // students: orders seat coverage under a college licence
  isCollegeAdmin    Boolean   @default(false) // faculty who manage the workspace, codes and licence
  College           CollegeInstitution? @relation(fields: [collegeId], references: [id])

  // Recruiter fields
  companyId         String?
  Company           Company?    @relation(fields: [companyId], references: [id])
  isVerified        Boolean     @default(false)

  // Student specific v2
  cgpa              Float?
  isProfileVisible  Boolean     @default(false)
  linkedin          String?     // Full LinkedIn profile URL
  github            String?     // Full GitHub profile URL

  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  skills              SkillProfile[]
  gaps                SkillGap[]
  sprints             Sprint[]
  optimizerSessions_  OptimizerSession[]

  OpenClawConfig       OpenClawConfig?
  OpenClawApplications OpenClawApplication[]
  ResumeVersions       ResumeVersion[]
  Applications         JobApplication[]
  TalentViews          RecruiterTalentView[] @relation("TalentViews")
  Notifications        Notification[]
  InterviewStories     InterviewStory[]
  NegotiationScripts   NegotiationScript[]
  AiUsage              AiUsage[]
  AuthTokens           AuthToken[]
  AcademicConnection   AcademicConnection?
  AcademicProfile      AcademicProfile?
  AcademicCourses      AcademicCourse[]
  AttendanceLeaves     AttendanceLeave[]
}

model SkillProfile {
  id          String   @id @default(cuid())
  userId      String
  skillName   String
  category    String   // technical | soft | tool | framework
  proficiency String   @default("beginner") // beginner | intermediate | advanced
  source      String   @default("resume")   // resume | manual
  extractedAt DateTime @default(now())

  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JobPosting {
  id             String    @id @default(cuid())
  company        String
  role           String
  location       String?
  salaryBand     String?
  requiredSkills Json      // string[]
  rawDescription String    @db.Text
  postedDate     DateTime?
  scrapedAt      DateTime  @default(now())
  source         String    @default("linkedin")
  demandWeek     Int       // ISO week number (1-53)

  @@index([demandWeek])
}

model SkillGap {
  id              String   @id @default(cuid())
  userId          String
  missingSkill    String
  urgency         String   // high | medium | low
  weeksToLearn    Int
  whyImportant    String   @db.Text
  demandScore     Float    @default(0)
  resourceLinks   Json?    // string[]
  closed          Boolean  @default(false)
  sprintGenerated Boolean  @default(false)
  identifiedAt    DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, closed])
}

model Sprint {
  id                   String    @id @default(cuid())
  userId               String
  weekStartDate        DateTime
  dayTasks             Json      // DayTask[7]
  completionPercentage Float     @default(0)
  skillsTargeted       Json      // string[3]
  status               String    @default("active") // active | completed | abandoned
  generatedAt          DateTime  @default(now())
  completedAt          DateTime?

  user                 User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model Benchmark {
  id             String   @id @default(cuid())
  role           String
  year           String
  readinessScore Float
  collegeTier    String   // Tier-1 | Tier-2 | Tier-3
  createdAt      DateTime @default(now())
  // NO userId - fully anonymous
}

model OptimizerSession {
  id             String   @id @default(cuid())
  userId         String
  targetRole     String
  atsScoreBefore Float
  atsScoreAfter  Float
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// V2 EXPANSION MODELS
// -------------------------------------------------------------

model CollegeInstitution {
  id             String   @id @default(cuid())
  name           String
  city           String
  state          String
  tier           String
  naacGrade      String?
  tpContactEmail String
  // Workspace access (ADR-001 Phase 4): students join with joinCode, faculty with facultyInviteCode
  joinCode          String?  @unique
  facultyInviteCode String?  @unique
  createdAt         DateTime @default(now())
  facultyUsers   User[]
  calendarDays   CollegeCalendarDay[]
}

model Company {
  id                 String   @id @default(cuid())
  name               String
  website            String?
  tier               String
  verificationStatus String   @default("pending")
  logoUrl            String?
  hrEmail            String
  recruiters         User[]
}

model FacultyJobPosting {
  id               String   @id @default(cuid())
  collegeId        String?
  companyId        String?
  title            String
  company          String
  description      String   @db.Text
  ctcMin           Float?
  ctcMax           Float?
  minCgpa          Float?
  eligibleBranches Json?    // string[]
  deadline         DateTime
  driveDate        DateTime?
  // Drive details (ADR-002 Phase 5), matching what placement portals such as Haveloc publish
  jobType          String?  // e.g. Full Time | Regular Intern | Intern Leads To Full Time
  location         String?
  stipendMin       Int?     // INR per month
  stipendMax       Int?
  duration         String?  // free text, e.g. "6 months"
  visitMode        String?  // physical | virtual | both | undecided
  source           String   @default("on_campus") // on_campus | off_campus | pool
  externalRef      String?  // the drive's id on the college's placement portal, for re-imports
  applyUrl         String?  // where students apply when the drive is run on another portal
  applicationCount Int      @default(0)
  createdAt        DateTime @default(now())

  @@unique([collegeId, externalRef])
  @@index([collegeId])
}

model JobApplication {
  id              String   @id @default(cuid())
  userId          String
  jobPostingId    String
  resumeVersionId String?
  coverLetter     String?  @db.Text
  status          String   @default("Applied") // Applied | Shortlisted | Rejected | Placed
  channel         String   @default("skillgraph") // skillgraph | external (student marked it applied on another portal)
  appliedAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobPostingId])
}

model ResumeVersion {
  id              String   @id @default(cuid())
  userId          String
  cloudinaryUrl   String?
  atsScore        Float?
  targetJd        String?  @db.Text
  generatedBy     String   @default("Manual") // AI | Manual
  createdAt       DateTime @default(now())

  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model OpenClawConfig {
  id                   String   @id @default(cuid())
  userId               String   @unique
  targetRoles          Json     // string[]
  preferredCities      Json     // string[]
  minCtcLpa            Float
  dailyLimit           Int      @default(10)
  blacklistedCompanies Json     // string[]
  isActive             Boolean  @default(true)
  applicationEmail     String?
  phone                String?

  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model OpenClawListing {
  id              String   @id @default(cuid())
  platform        String
  company         String
  role            String
  location        String?
  ctcBand         String?
  jdText          String   @db.Text
  sourceUrl       String
  scrapedAt       DateTime @default(now())

  applications    OpenClawApplication[]
}

model OpenClawApplication {
  id              String   @id @default(cuid())
  userId          String
  listingId       String
  matchScore      Float?
  resumeVersionId String?
  status          String   @default("Pending") // see lib/openclaw/status.ts
  screenshotUrl   String?
  tailoringNotes  String?  @db.Text
  appliedAt       DateTime @default(now())

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing         OpenClawListing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([listingId])
}

model RecruiterTalentView {
  id              String    @id @default(cuid())
  recruiterId     String
  studentId       String
  revealedAt      DateTime?
  shortlisted     Boolean   @default(false)
  // Mutual-consent reveal: none | requested | accepted | declined. Identity is shared only when accepted.
  revealStatus    String    @default("none")
  requestedAt     DateTime?
  respondedAt     DateTime?
  viewedAt        DateTime  @default(now())
  notes           String?

  student         User      @relation("TalentViews", fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([recruiterId, studentId])
  @@index([studentId])
}

model IndiaMarketData {
  id              String   @id @default(cuid())
  skill           String?
  role            String?
  city            String?
  demandCount     Int?
  avgCtcLpa       Float?
  companyTier     String?
  weekOf          DateTime
}

model PlacementRecord {
  id              String   @id @default(cuid())
  collegeId       String
  studentId       String
  company         String
  role            String
  ctcLpa          Float?
  offerDate       DateTime?
  batch           String?
  isVerified      Boolean  @default(false)

  @@index([collegeId])
}

model ResumeSection {
  id              String   @id @default(cuid())
  resumeVersionId String
  type            String   // Summary | Experience | Skills | Projects | Education
  content         Json
  atsContribution Float?

  @@index([resumeVersionId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   // job_posted | status_changed | shortlisted | offer | system
  title     String
  body      String   @db.Text
  link      String?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// -------------------------------------------------------------
// CAREER-OPS SPRINT 9 MODELS
// -------------------------------------------------------------

model EvaluationResult {
  id                  String   @id @default(cuid())
  applicationId       String   @unique
  totalScore          Float
  grade               String   // A | B | C | D | F
  dimensions          Json     // Record<string, {score, maxScore, reasoning}>
  recommendation      String   // AutoApply | ReviewAndApply | Skip
  keyStrengths        Json     // string[]
  keyWeaknesses       Json     // string[]
  negotiationLeverage String   @db.Text
  createdAt           DateTime @default(now())
}

model InterviewStory {
  id             String   @id @default(cuid())
  userId         String
  theme          String   // Leadership | Tech | Conflict | Collaboration | Failure | Growth
  company        String?
  role           String?
  starSituation  String   @db.Text
  starTask       String   @db.Text
  starAction     String   @db.Text
  starResult     String   @db.Text
  starReflection String   @db.Text
  createdAt      DateTime @default(now())

  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model NegotiationScript {
  id        String   @id @default(cuid())
  userId    String
  listingId String
  script1   Json     // Geographic Discount — { openingLine, mainArgument, closingLine }
  script2   Json     // Competing Offer Leverage
  script3   Json     // Skill Premium
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------
// PLATFORM / OPERATIONS
// -------------------------------------------------------------

// One row per LLM call — drives per-user daily quotas and cost reporting (lib/ai)
model AiUsage {
  id               String   @id @default(cuid())
  userId           String?
  feature          String   // e.g. resume_parse, gap_analysis, sprint
  model            String
  promptTokens     Int      @default(0)
  completionTokens Int      @default(0)
  success          Boolean  @default(true)
  createdAt        DateTime @default(now())

  user             User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
}

// Single-use, hashed tokens for email verification and password reset
model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  type      String    // email_verify | password_reset
  tokenHash String    @unique // SHA-256 of the token sent by email; the raw token is never stored
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
}

// -------------------------------------------------------------
// BILLING (ADR-001 Phase 4) — prepaid plan periods paid through Razorpay
// -------------------------------------------------------------

// One paid period (or pending checkout) of a plan for a user, college or company
model Subscription {
  id                 String    @id @default(cuid())
  ownerType          String    // user | college | company
  ownerId            String
  plan               String    // see lib/billing/plans.ts
  status             String    @default("pending") // pending | active | expired | failed
  seats              Int?      // college licences
  amountPaise        Int
  currency           String    @default("INR")
  provider           String    @default("razorpay")
  providerOrderId    String    @unique
  periodStart        DateTime?
  periodEnd          DateTime?
  purchasedByUserId  String
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  payments           Payment[]

  @@index([ownerType, ownerId, status])
  @@index([status, periodEnd])
}

model Payment {
  id                String       @id @default(cuid())
  subscriptionId    String
  providerPaymentId String       @unique
  amountPaise       Int
  currency          String       @default("INR")
  status            String       // captured | failed
  method            String?
  createdAt         DateTime     @default(now())

  subscription      Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

// Processed provider webhook ids, so retries are handled exactly once
model WebhookEvent {
  id          String   @id // provider event id
  provider    String
  type        String
  receivedAt  DateTime @default(now())
}

// -------------------------------------------------------------
// ACADEMICS (ADR-002 Phase 5) — attendance, marks, timetable and calendar
// -------------------------------------------------------------

// A student's link to their university's academic system (lib/academics). The password
// connector never stores the password: only the portal session, encrypted at rest.
model AcademicConnection {
  id                String    @id @default(cuid())
  userId            String    @unique
  provider          String    // srm_api | srm_academia
  externalId        String?   // university login id or register number
  status            String    @default("active") // active | needs_reauth | error
  sessionCiphertext String?   @db.Text
  sessionExpiresAt  DateTime?
  consentAt         DateTime
  lastSyncAt        DateTime?
  lastError         String?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// Student details, timetable and calendar from the latest sync (JSON shapes: lib/academics/types.ts)
model AcademicProfile {
  userId     String   @id
  regNo      String?
  program    String?
  department String?
  semester   Int?
  section    String?
  batch      String?
  timetable  Json?    // TimetableEntry[]
  calendar   Json?    // CalendarDay[]
  source     String   // srm_api | srm_academia | college
  syncedAt   DateTime

  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([regNo])
}

// One enrolled course with its attendance and marks, from a sync or a college import
model AcademicCourse {
  id        String   @id @default(cuid())
  userId    String
  code      String
  title     String
  category  String   // theory | practical
  credits   Float?
  faculty   String?
  slot      String?
  room      String?
  attended  Int      @default(0)
  conducted Int      @default(0)
  marks     Json?    // MarkComponent[]
  source    String   // srm_api | srm_academia | college
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code, category])
}

// Dates a student marks as on-duty or medical leave; attendance projections exclude them
model AttendanceLeave {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime @db.Date
  kind      String   // OD | ML
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// A college's academic calendar (day orders and holidays), imported by its faculty
model CollegeCalendarDay {
  id        String             @id @default(cuid())
  collegeId String
  date      DateTime           @db.Date
  dayOrder  Int?               // null on holidays and weekends
  label     String?            // e.g. "Diwali", "CAT-1 begins"

  college   CollegeInstitution @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([collegeId, date])
}
