# Copy to .env.local and fill in. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/skillgraph"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OpenAI-compatible LLM endpoint (defaults to Groq when OPENAI_BASE_URL is unset)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Résumé storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Vercel Cron (vercel.json) sends it as "Authorization: Bearer <CRON_SECRET>"; other schedulers
# may send it as the x-cron-secret header. Cron endpoints reject every call when this is unset.
CRON_SECRET=""

# ── Accounts, email & legal ───────────────────────────────────────────────
# Public base URL used in emailed links (defaults to NEXTAUTH_URL)
APP_URL="http://localhost:3000"
# Shown on /privacy and /terms as the privacy / grievance contact
CONTACT_EMAIL="privacy@example.com"
# SENDGRID_API_KEY / SENDGRID_FROM_EMAIL (below) are required in production for
# verification and password-reset emails; in development emails are logged instead.

# ── Payments (Razorpay) ───────────────────────────────────────────────────
# Use rzp_test_… keys until launch. Billing pages show "payments not enabled" while unset.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Dashboard → Webhooks: URL https://<your-domain>/api/billing/webhook,
# events payment.captured, order.paid, payment.failed; paste the secret here
RAZORPAY_WEBHOOK_SECRET=""

# ── Observability ─────────────────────────────────────────────────────────
# debug | info | warn | error
LOG_LEVEL="info"
# Optional: POST a JSON report of every unhandled server error here (incident channel / collector)
ERROR_WEBHOOK_URL=""

# ── Recommended for production ────────────────────────────────────────────
# Shared rate-limit counters across instances (falls back to per-instance memory when unset)
RATE_LIMIT_REDIS_URL=""
# Optional emergency cap on LLM tokens per user per 24h; per-plan limits live in lib/billing/plans.ts
AI_DAILY_TOKEN_LIMIT=""
# Chat model on the OpenAI-compatible provider (default: openai/gpt-oss-120b on Groq)
AI_MODEL=""

# ── Job discovery (OpenClaw + market data) — at least one source is needed ──
# JSearch via RapidAPI (licensed aggregator)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="jsearch.p.rapidapi.com"
# Adzuna (optional second source) — https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in"

# OpenClaw auto-submit (ADR-004): API keys employers have issued to SkillGraph, as JSON.
# Keys: "greenhouse:<board token>" (Job Board API key) or "lever:<site>" (Postings API key).
# Leave empty: every application then waits for the student to submit.
ATS_PARTNER_KEYS=""

# ── Optional worker service (npm run worker / Dockerfile.worker) ──────────
# Only if the scheduled jobs run outside Vercel Cron (never both). Use rediss:// for TLS providers
REDIS_URL=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
# Health check port for the worker container
PORT="8080"
# Set to "true" to refresh market data immediately on worker start (uses API quota)
RUN_SCRAPER_ON_START="false"

# Set to "true" only on a staging/demo database to enable POST /api/market/india/seed in production builds
ALLOW_DEMO_SEED="false"

# ── Academics (ADR-002 Phase 5): attendance, marks, timetable ─────────────
# 32 random bytes, base64 (openssl rand -base64 32). Encrypts stored university portal sessions.
ACADEMIC_ENCRYPTION_KEY=""
# Students connecting through the official API must have a verified email on this domain
SRM_EMAIL_DOMAIN="srmist.edu.in"
# Official university API, once SRM issues SkillGraph an API key (contract: lib/academics/providers.ts)
SRM_API_BASE_URL=""
SRM_API_KEY=""
# "enabled" turns on the Academia sign-in connector (needs its portal transport implemented first)
SRM_ACADEMIA_CONNECTOR=""
