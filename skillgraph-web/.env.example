# Copy to .env.local and fill in. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/skillgraph"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OpenAI-compatible LLM endpoint (defaults to Groq when OPENAI_BASE_URL is unset)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Résumé storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Shared secret sent as the x-cron-secret header by your scheduler.
# Cron endpoints reject every call when this is unset.
CRON_SECRET=""

# ── Recommended for production ────────────────────────────────────────────
# Shared rate-limit counters across instances (falls back to per-instance memory when unset)
RATE_LIMIT_REDIS_URL=""
# Max LLM tokens per user per rolling 24h (default 200000)
AI_DAILY_TOKEN_LIMIT="200000"

# ── Job discovery (OpenClaw + market data) — at least one source is needed ──
# JSearch via RapidAPI (licensed aggregator)
RAPIDAPI_KEY=""
RAPIDAPI_HOST="jsearch.p.rapidapi.com"
# Adzuna (optional second source) — https://developer.adzuna.com
ADZUNA_APP_ID=""
ADZUNA_APP_KEY=""
ADZUNA_COUNTRY="in"

# ── Background worker service (npm run worker / Dockerfile.worker) ────────
# Use rediss:// for TLS providers such as Upstash
REDIS_URL=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""
# Health check port for the worker container
PORT="8080"
# Set to "true" to refresh market data immediately on worker start (uses API quota)
RUN_SCRAPER_ON_START="false"

# Set to "true" only on a staging/demo database to enable POST /api/market/india/seed in production builds
ALLOW_DEMO_SEED="false"
