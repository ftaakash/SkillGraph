# Copy to .env.local and fill in. Never commit real values.

# ── Required ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://user:password@localhost:5432/skillgraph"
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# OpenAI-compatible LLM endpoint (defaults to Groq when OPENAI_BASE_URL is unset)
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Résumé storage
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ── Scheduled jobs ────────────────────────────────────────────────────────
# Shared secret sent as the x-cron-secret header by your scheduler.
# Cron endpoints reject every call when this is unset.
CRON_SECRET=""

# ── Optional ──────────────────────────────────────────────────────────────
# JSearch job market data
RAPIDAPI_KEY=""
RAPIDAPI_HOST="jsearch.p.rapidapi.com"

# Background workers (workers/index.ts)
REDIS_URL=""
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Set to "true" only on a staging/demo database to enable POST /api/market/india/seed in production builds
ALLOW_DEMO_SEED="false"
